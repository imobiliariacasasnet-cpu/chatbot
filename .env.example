# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# required for non-vercel deployments, vercel uses OIDC automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# https://vercel.com/docs/postgres
POSTGRES_URL=****

# https://vercel.com/docs/redis
REDIS_URL=****

# Receipt scanning (configure in Vercel Project Settings > Environment Variables).
# Keep the real key in Vercel only; never expose it in frontend JavaScript.
OPENAI_API_KEY=replace-with-your-secret-api-key
OPENAI_RECEIPT_MODEL=gpt-4o-mini
APP_ORIGIN=https://your-project.vercel.app
